{
	email {$ACME_EMAIL}
	# Dla trybu subdomen klientów (*.BASE_DOMAIN): certyfikaty na żądanie tylko dla istniejących klientów.
	on_demand_tls {
		ask http://app:8000/api/tls-check
	}
}

{$DOMAIN} {
	encode gzip
	reverse_proxy app:8000
}

